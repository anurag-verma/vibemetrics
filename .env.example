# Production checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# Configure trusted proxies if behind Cloudflare/nginx (see Laravel docs).
# ANALYTICS_TRUST_GEO_HEADERS=true only when geo headers come from your CDN/proxy.

APP_NAME=VibeMetrics
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: APP_ENV=production, APP_DEBUG=false

APP_URL=http://localhost
# Production: APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production (MySQL example):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vibemetrics
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Session lifetime in minutes (43200 = 30 days).
SESSION_LIFETIME=43200
# "Remember me" cookie duration in minutes (43200 = 30 days).
AUTH_REMEMBER_DURATION=43200
# Set SESSION_ENCRYPT=true in production when possible.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true when serving over HTTPS.
# SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Analytics defaults (overridable in Admin → Settings)
# ANALYTICS_RETENTION_DAYS=365
# ANALYTICS_ROLLUP_ENABLED=true
# ANALYTICS_TRUST_GEO_HEADERS=false
# ANALYTICS_ENFORCE_DOMAIN=true
# TRUSTED_PROXIES=*  (or comma-separated IPs; required behind Cloudflare/nginx)
